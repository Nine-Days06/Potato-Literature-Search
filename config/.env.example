# ── API 密钥配置 ──────────────────────────────────
# 复制此文件为 .env，填入你的真实密钥后保存
# .env 已在 .gitignore 中，不会被提交到仓库

# NCBI E-utilities API Key（免费申请：https://www.ncbi.nlm.nih.gov/account/）
# 留空也可运行，但速率限制为 3 次/秒
NCBI_API_KEY=

# DeepSeek API Key（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=

# 智谱AI API Key（https://open.bigmodel.cn/）
ZHIPU_API_KEY=

# 其他 OpenAI 兼容 API Key（如 OpenAI、SiliconFlow、本地 vLLM 等）
OPENAI_API_KEY=

# NCBI 联系邮箱（NCBI 强制要求，否则 API 可能被限）
NCBI_EMAIL=

# 可选：HTTP/HTTPS 代理（访问 NCBI 等外网走代理，如 http://127.0.0.1:7890）
# 留空则直连
PROXY=


# ── LLM 配置 ─────────────────────────────────────
# 以下全部可选，未设置时使用 config/settings.py 中的默认值。
# 切换模型/并发等只需改这里，不必修改 settings.py。

# 使用哪个 provider：deepseek | zhipu | openai
# 注意 openai 指"OpenAI 兼容协议"，可指向 OpenAI 官方、SiliconFlow、
# 本地 vLLM 或任意兼容网关，具体地址由 OPENAI_BASE_URL 决定。
LLM_PROVIDER=openai

# ── 各 provider 的模型与地址（按需覆盖）──
# DeepSeek
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# 智谱
# ZHIPU_MODEL=
# ZHIPU_BATCH_MODEL=

# OpenAI 兼容网关（默认指向本地 3425 端口的 deepseek 代理）
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# ── 验证行为参数 ──
# 每次 API 调用携带的文献数（越大越快，但单次失败影响面也越大）
# LLM_BATCH_SIZE=5
# 并行批次数（同时进行的 API 调用数）。本地网关建议 2-4，官方 API 看限流
# LLM_CONCURRENCY=2
# 单次调用最大输出 token（过小会导致 JSON 截断）
# LLM_MAX_TOKENS=8192
# 单次调用超时（秒）
# LLM_TIMEOUT=120
# 单次调用重试次数（指数退避 2s/4s/8s）
# LLM_MAX_RETRIES=3
# 整轮重试次数（初始 1 轮 + 额外重试轮数）
# LLM_MAX_ROUNDS=2

# ── 智谱 Batch API 参数（仅 LLM_PROVIDER=zhipu 时生效）──
# LLM_BATCH_POLL_INTERVAL=30
# LLM_BATCH_TIMEOUT=86400
# LLM_BATCH_AUTO_DELETE=true

# ── TDM 全文获取（订阅内容）─────────────────────────
# 用于补齐「LLM 判相关但没有 PMC 开放获取全文」的文献。
# 两条渠道授权模型不同，务必看清：

# Wiley TDM Client Token（UUID 格式）。
# 申请：https://static.wiley.com/tdm/ （页面由 JS 渲染，需用浏览器打开）
# 特点：token 授权 + 请求源 IP 必须在机构网段内；校外需先连学校 VPN。返回 PDF。
# 注意：速率上限不是「3 篇/秒」，条款同时限制 60 次/10 分钟。
WILEY_TDM_TOKEN=

# Elsevier API Key（https://dev.elsevier.com/apikey/manage 自助注册，几分钟出 key）
# 警告：key 只标识应用，**不含内容权限**。内容权限靠请求源 IP 归属机构，
# 或下面这个 insttoken。家庭宽带直连时即使有 key，返回体里也只有摘要。
ELSEVIER_API_KEY=

# Elsevier 机构 token（需联系 integration support 签发，只能服务端存放）。
# 没有它就必须让请求走校园网/VPN 出口。
ELSEVIER_INSTTOKEN=

# 请求间隔（秒）。Wiley 官方客户端默认 5，这里默认 10（按 60 次/10 分钟折算）
# WILEY_TDM_INTERVAL=10
# ELSEVIER_TDM_INTERVAL=2
# 单篇体积上限（字节），超过视为错误页
# TDM_MAX_BYTES=52428800
# TDM_TIMEOUT=120
